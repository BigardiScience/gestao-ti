# Copie este arquivo para .env e ajuste. Tudo é opcional.

# Endereço e porta do servidor
HOST=0.0.0.0
PORTA=8000

# Pasta dos dados (banco, PDFs assinados, backups, logs). Padrão: ./instance
# PASTA_DADOS=/srv/celulares/dados

# Endereço público do sistema (também configurável na tela de Configurações)
# URL_BASE=https://celulares.empresa.com.br

# Use 1 quando o sistema estiver atrás de um proxy reverso (nginx, IIS, Cloudflare)
# para registrar o IP real de quem assina e reconhecer o computador de quem abre um pedido para a TI.
CONFIAR_PROXY=0

# Minutos sem uso até o sistema pedir login de novo (0 desliga). Padrão: 30
# SESSAO_INATIVIDADE_MIN=30
# Tela "Pedidos para a TI" (colaboradores, máquinas compartilhadas): sessão mais curta
# SESSAO_INATIVIDADE_COLABORADOR_MIN=10

# Tarefas automáticas (lembretes, resumo diário, backup). 0 = desligado
AGENDADOR_ATIVO=1

# Chave mestra (opcional). Se não definir, o sistema cria instance/chave-mestra.key.
# CHAVE_MESTRA=

LOG_NIVEL=INFO
